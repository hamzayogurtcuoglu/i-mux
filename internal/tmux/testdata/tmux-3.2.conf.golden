# Generated by imux. Do not edit; put overrides in /home/test/.imux/tmux.local.conf
# tmux 3.2a, agent bar: on, clickable: off

set -g  default-terminal tmux-256color
%if "#{!=:#{@imux_loaded},1}"
set -as terminal-features ',*:RGB'
set -as terminal-features ',*:extkeys'
%endif
set -g  @imux_loaded 1
# Updates of a pane in the background (a sidebar's spinner) reach the terminal as one
# synchronized update (DECSET 2026), with the cursor's way back to the active pane: it never
# shows in the sidebar mid-update. tmux 3.2's own Sync is an older form; terminals without
# 2026 ignore it. Applies to clients that attach after it is set.
%if "#{!=:#{@imux_sync},1}"
set -as terminal-overrides ',*:Sync=\E[?2026%?%p1%{1}%-%tl%eh%;'
%endif
set -g  @imux_sync 1
set -s  extended-keys on
set -s  escape-time 10
set -g  history-limit 50000
set -g  mouse on
set -g  focus-events on
set -g  pane-border-status top
set -g  automatic-rename-format '#{?@imux_agent,#{@imux_agent},#{pane_current_command}}'
set -g  pane-border-format ' #{?@imux_name,#{@imux_name} · ,}#{?@imux_label,#{@imux_label},#{pane_current_command}} #{?@imux_flag,#{@imux_flag} ,}'
set -g  status-right '#{?@imux_status,#{@imux_status} · ,}%H:%M '
set -g  status-right-length 80
set -g  status-left-length 32
set -gq @imux_status ''
# Tab bar at the top: the session's windows, and + for a new tab.
set -g  status-position top
set -g  status-format[0] '#[align=left]#[range=window|#{window_index}]#{?window_zoomed_flag,,#{P:#{?#{==:#{@imux_role},sidebar},#{p/#{e|+:#{pane_width},1}/:},}}}#[norange] #{W:#[range=window|#{window_index}]#[fg=#{@imux_c_subtext0}] #I #{?@imux_tab,#{@imux_tab},#{?@imux_tab_auto,#{@imux_tab_auto},#W}} #{?@imux_tab_state,#{@imux_tab_state}, } #[norange default] ,#[range=window|#{window_index}]#[bg=#{@imux_c_surface0} fg=#{@imux_c_text} bold] #I #{?@imux_tab,#{@imux_tab},#{?@imux_tab_auto,#{@imux_tab_auto},#W}} #{?@imux_tab_state,#{@imux_tab_state}, }#[norange] #[range=left]#[bg=#{@imux_c_surface0} fg=#{@imux_c_overlay1} nobold] × #[norange default] }#[fg=#{@imux_c_subtext0}] + #[norange default]#[align=right]#[range=right]#[fg=#{@imux_c_subtext0}] ⏻ Exit #[norange default] '
set -g  status 2
set -g  status-format[1] '#[align=left] imux #[range=user|imux:menu]☰#[norange default]'
# The theme's colors (D68): the tab bar reads @imux_c_*; styles of the status line, borders,
# messages, the copy mode, popups and menus.
set -g  @imux_c_accent '#89b4fa'
set -g  @imux_c_panel_bg '#181825'
set -g  @imux_c_sidebar_bg default
set -g  @imux_c_active_row_bg '#1e1e2e'
set -g  @imux_c_selection_bg '#313244'
set -g  @imux_c_surface0 '#313244'
set -g  @imux_c_surface1 '#45475a'
set -g  @imux_c_surface_dim '#1e1e2e'
set -g  @imux_c_overlay0 '#6c7086'
set -g  @imux_c_overlay1 '#7f849c'
set -g  @imux_c_text '#cdd6f4'
set -g  @imux_c_subtext0 '#a6adc8'
set -g  @imux_c_mauve '#cba6f7'
set -g  @imux_c_green '#a6e3a1'
set -g  @imux_c_yellow '#f9e2af'
set -g  @imux_c_red '#f38ba8'
set -g  @imux_c_blue '#89b4fa'
set -g  @imux_c_teal '#94e2d5'
set -g  @imux_c_peach '#fab387'
set -g  status-style 'bg=default,fg=#a6adc8'
set -g  pane-border-style 'fg=#45475a'
set -g  pane-active-border-style 'fg=#89b4fa'
set -g  message-style 'bg=#313244,fg=#cdd6f4'
set -g  message-command-style 'bg=#313244,fg=#cdd6f4'
set -g  mode-style 'bg=#313244,fg=#cdd6f4'

# Pane menu, session picker.
bind -n 'C-\' run-shell -b '/opt/imux/bin/imux __menu --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    a run-shell -b '/opt/imux/bin/imux __menu --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
# Go to File, the editor's Ctrl+P (§9.3).
bind -n C-p run-shell -b '/opt/imux/bin/imux __goto --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    S run-shell -b '/opt/imux/bin/imux __menu --sessions --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
# Ctrl+V / Alt+V in an agent's pane paste the clipboard's image; elsewhere, or with no image, the key goes on.
bind -n C-v if-shell -F '#{@imux_agent}' "run-shell -b '/opt/imux/bin/imux __paste-image --pane #{pane_id} --client #{client_name} --key C-v >/dev/null 2>&1 || true'" 'send-keys C-v'
bind -n M-v if-shell -F '#{@imux_agent}' "run-shell -b '/opt/imux/bin/imux __paste-image --pane #{pane_id} --client #{client_name} --key M-v >/dev/null 2>&1 || true'" 'send-keys M-v'
# Sidebar on/off, and splits that ask which agent to start.
bind    b run-shell -b '/opt/imux/bin/imux sidebar toggle --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    v run-shell -b '/opt/imux/bin/imux __menu --split h --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    - run-shell -b '/opt/imux/bin/imux __menu --split v --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
# Panes from the keyboard (D67): swap with the pane on a side, the resize mode, the help.
bind    H run-shell -b '/opt/imux/bin/imux __pane swap left --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    J run-shell -b '/opt/imux/bin/imux __pane swap down --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    K run-shell -b '/opt/imux/bin/imux __pane swap up --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    L run-shell -b '/opt/imux/bin/imux __pane swap right --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    r { switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize h { resize-pane -L 2 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize j { resize-pane -D 2 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize k { resize-pane -U 2 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize l { resize-pane -R 2 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize Left { resize-pane -L 2 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize Down { resize-pane -D 2 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize Up { resize-pane -U 2 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize Right { resize-pane -R 2 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize H { resize-pane -L 10 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize J { resize-pane -D 10 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize K { resize-pane -U 10 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize L { resize-pane -R 10 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize S-Left { resize-pane -L 10 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize S-Down { resize-pane -D 10 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize S-Up { resize-pane -U 10 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize S-Right { resize-pane -R 10 ; switch-client -T imux-resize ; display-message -d 0 'Resize: h j k l or arrows (Shift: faster) · Esc, Enter or q: done' }
bind -T imux-resize Escape { switch-client -T root ; display-message -d 1 '' }
bind -T imux-resize Enter { switch-client -T root ; display-message -d 1 '' }
bind -T imux-resize q { switch-client -T root ; display-message -d 1 '' }
bind    '?' run-shell -b '/opt/imux/bin/imux __menu --keys --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
# New tab (asks which agent) and the tab's name.
bind    c run-shell -b '/opt/imux/bin/imux __menu --tab --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    , command-prompt -I '#{@imux_tab}' -p 'Tab name:' 'set-option -w @imux_tab "%%%"'
# tmux before 3.4: the tab bar's × is its status-left range, ⏻ Exit its status-right range and the +
# the bar outside any range; clicks go to imux when the button is released.
bind -n MouseUp1StatusLeft run-shell -b '/opt/imux/bin/imux __click imux:close --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind -n MouseUp1StatusRight run-shell -b '/opt/imux/bin/imux __click imux:quit --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind -n MouseUp1StatusDefault run-shell -b '/opt/imux/bin/imux __click imux:tab --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
# Right-click on a pane border opens that pane's menu (-t = is the pane under the mouse).
bind -n MouseDown3Border run-shell -t = -b '/opt/imux/bin/imux __menu --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
# A sidebar acts on a click at once, so a double or triple click on it must not select it
# (tmux's own bindings do, 300 ms after a double click: the focus went back to the sidebar),
# and the second and third press reach a sidebar only if the first did: a click that showed
# another tab or project must not act again in that one's sidebar. Other panes keep tmux's
# defaults (tmux's MouseDown1Pane, which also notes the pane, @imux_press). tmux 3.7+ reports
# a second press in another pane as a new one: while a click that showed this client another
# tab or project is fresh (@imux_moved, D53), its presses on a sidebar are dropped.
bind -n MouseDown1Pane if -F -t= '#{&&:#{==:#{@imux_role},sidebar},#{==:#{@imux_moved},#{client_name}}}' {} { set -gF @imux_press '#{mouse_pane}'; select-pane -t=; send -M }
bind -n SecondClick1Pane if -F -t= '#{||:#{!=:#{@imux_role},sidebar},#{==:#{pane_id},#{@imux_press}}}' { send -M } {}
bind -n DoubleClick1Pane if -F -t= '#{==:#{@imux_role},sidebar}' { send -M } { select-pane -t=; if -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' { send -M } { copy-mode -H; send -X select-word; run -d0.3; send -X copy-pipe-and-cancel } }
bind -n TripleClick1Pane if -F -t= '#{==:#{@imux_role},sidebar}' { if -F -t= '#{==:#{pane_id},#{@imux_press}}' { send -M } {} } { select-pane -t=; if -F '#{||:#{pane_in_mode},#{mouse_any_flag}}' { send -M } { copy-mode -H; send -X select-line; run -d0.3; send -X copy-pipe-and-cancel } }
set -g  @imux_keys 'root C-\,root C-p,prefix a,prefix S,imux-resize h,imux-resize j,imux-resize k,imux-resize l,imux-resize Left,imux-resize Down,imux-resize Up,imux-resize Right,imux-resize H,imux-resize J,imux-resize K,imux-resize L,imux-resize S-Left,imux-resize S-Down,imux-resize S-Up,imux-resize S-Right,imux-resize Escape,imux-resize Enter,imux-resize q,prefix b,prefix v,prefix -,prefix r,prefix ?,prefix H,prefix J,prefix K,prefix L,prefix c,prefix ,,root MouseUp1StatusLeft,root MouseUp1StatusRight,root MouseUp1StatusDefault,root MouseDown3Border,root MouseDown1Pane,root SecondClick1Pane,root DoubleClick1Pane,root TripleClick1Pane,root C-v,root M-v'

# Pane lifecycle and watcher.
set-hook -g pane-died "run-shell -b '/opt/imux/bin/imux __pane-died #{pane_id} #{pane_dead_status} >/dev/null 2>&1 || true'"
set-hook -g client-attached "run-shell -b '/opt/imux/bin/imux __watch ensure >/dev/null 2>&1 || true'"
# Sidebars redraw when panes change (they sleep otherwise).
set-hook -g pane-focus-in "run-shell -b '/opt/imux/bin/imux __sidebar-refresh >/dev/null 2>&1 || true'"
set-hook -g after-split-window "run-shell -b '/opt/imux/bin/imux __sidebar-refresh >/dev/null 2>&1 || true'"
set-hook -g after-kill-pane "run-shell -b '/opt/imux/bin/imux __sidebar-refresh >/dev/null 2>&1 || true'"
set-hook -g pane-exited "run-shell -b '/opt/imux/bin/imux __sidebar-refresh >/dev/null 2>&1 || true'"
set-hook -g window-pane-changed "run-shell -b '/opt/imux/bin/imux __sidebar-refresh >/dev/null 2>&1 || true'"

source-file -q /home/test/.imux/tmux.local.conf
