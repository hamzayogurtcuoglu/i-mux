# Generated by ajan. Do not edit; put overrides in /home/test/.ajan/tmux.local.conf
# tmux 3.2a, agent bar: on, clickable: off

set -g  default-terminal tmux-256color
%if "#{!=:#{@ajan_loaded},1}"
set -as terminal-features ',*:RGB'
set -as terminal-features ',*:extkeys'
%endif
set -g  @ajan_loaded 1
set -s  extended-keys on
set -s  escape-time 10
set -g  history-limit 50000
set -g  mouse on
set -g  focus-events on
set -g  pane-border-status top
set -g  pane-border-format ' #{?@ajan_label,#{@ajan_label},#{pane_current_command}} #{?@ajan_flag,#{@ajan_flag} ,}'
set -g  status-right '#{?@ajan_status,#{@ajan_status} · ,}%H:%M '
set -g  status-right-length 80
set -gq @ajan_status ''
set -g  status 2
set -g  status-format[1] '#[align=left] ajan #[range=user|ajan:menu]☰#[norange default]'

# Pane menu, session picker.
bind -n 'C-\' run-shell -b '/opt/ajan/bin/ajan __menu --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    a run-shell -b '/opt/ajan/bin/ajan __menu --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
bind    S run-shell -b '/opt/ajan/bin/ajan __menu --sessions --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
# Right-click on a pane border opens that pane's menu (-t = is the pane under the mouse).
bind -n MouseDown3Border run-shell -t = -b '/opt/ajan/bin/ajan __menu --pane #{pane_id} --client #{client_name} >/dev/null 2>&1 || true'
set -g  @ajan_keys 'root C-\,prefix a,prefix S,root MouseDown3Border'

# Pane lifecycle and watcher.
set-hook -g pane-died "run-shell -b '/opt/ajan/bin/ajan __pane-died #{pane_id} #{pane_dead_status} >/dev/null 2>&1 || true'"
set-hook -g client-attached "run-shell -b '/opt/ajan/bin/ajan __watch ensure >/dev/null 2>&1 || true'"

source-file -q /home/test/.ajan/tmux.local.conf
